<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ego.app">

    <!-- الصلاحيات الأساسية للموقع والخدمات -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Ego"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- النشاط الرئيسي (MainActivity) مع دعم Deep Links -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- استقبال الروابط الخارجية والإحداثيات -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ego" android:host="trigger" />
            </intent-filter>
        </activity>

        <!-- الخدمة الأمامية المسؤولة عن التتبع المستمر في الخلفية -->
        <service
            android:name=".core.EgoForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

    </application>
</manifest>